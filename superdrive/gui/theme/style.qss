QMainWindow {
    background: #2b2b2b;
}

QWidget#workspace {
    background: #2b2b2b;
}

QMenuBar {
    color: #b8b8b8;
    background: #2b2b2b;
    border: 0;
    border-bottom: 1px solid #3d3d3d;
    font-size: 11px;
    padding: 0 5px;
}

QMenuBar::item {
    color: #b8b8b8;
    background: transparent;
    padding: 2px 7px;
    margin: 0;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    color: #f0f0f0;
    background: #3a3a3a;
    border-radius: 4px;
}

QMenu {
    color: #d0d0d0;
    background: #303030;
    border: 1px solid #4a4a4a;
    font-size: 11px;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 26px 5px 22px;
    background: transparent;
}

QMenu::item:selected {
    color: #1a1a1a;
    background: #d2a050;
}

QToolBar#deviceToolbar {
    background: #333333;
    border: 0;
    border-bottom: 1px solid #444444;
    spacing: 5px;
    padding: 4px 7px;
}

QToolBar#deviceToolbar::separator {
    background: #4a4a4a;
    width: 1px;
    margin: 4px 6px;
}

QLabel#toolbarLabel {
    color: #999999;
    font-size: 11px;
    font-weight: 600;
    padding: 0 2px 0 0;
}

QComboBox#deviceCombo {
    min-height: 24px;
    padding: 2px 24px 2px 8px;
    color: #e0e0e0;
    background: #3c3c3c;
    border: 1px solid #505050;
    border-radius: 5px;
    font-size: 11px;
}

QComboBox#deviceCombo:hover {
    border-color: #666666;
}

QComboBox#deviceCombo:focus {
    border-color: #5a82b4;
}

QComboBox#deviceCombo::drop-down {
    border: 0;
    width: 24px;
}

QToolBar#deviceToolbar QToolButton {
    min-height: 24px;
    padding: 2px 8px;
    color: #d0d0d0;
    background: #3c3c3c;
    border: 1px solid #505050;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
}

QToolBar#deviceToolbar QToolButton:hover {
    background: #484848;
    border-color: #666666;
}

QToolBar#deviceToolbar QToolButton:pressed {
    background: #2f2f2f;
}

QScrollArea#controlsPane {
    background: #2f2f2f;
    border: 0;
}

QWidget#controlsContent {
    background: #2f2f2f;
}

QFrame#deviceInfoPanel {
    background: #383838;
    border: 1px solid #4a4a4a;
    border-radius: 7px;
}

QLabel#deviceBadge {
    color: #b0b0b0;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 9px;
    background: #3c3c3c;
    border-radius: 5px;
}

QLabel#deviceBadge[apple="true"] {
    color: #1a1a1a;
    background: #d2a050;
}

QLabel#devicePathLabel {
    color: #e0e0e0;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 0 0 0;
}

QLabel#deviceUsbLabel {
    color: #888888;
    font-size: 10px;
    padding: 1px 0 0 0;
}

QLabel#deviceSysfsLabel {
    color: #666666;
    font-size: 10px;
    padding: 2px 0 0 0;
}

QLabel#sectionHeader {
    color: #777777;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 2px 0 0 0;
}

QWidget#controlsContent QToolButton {
    min-height: 24px;
    padding: 2px 7px;
    color: #d0d0d0;
    background: #3c3c3c;
    border: 1px solid #505050;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
}

QWidget#controlsContent QToolButton:hover {
    background: #484848;
    border-color: #666666;
}

QWidget#controlsContent QToolButton:pressed {
    background: #2f2f2f;
}

QWidget#controlsContent QToolButton:disabled {
    color: #5a5a5a;
    background: #333333;
    border-color: #404040;
}

QWidget#controlsContent QToolButton[primary="true"] {
    color: #1a1a1a;
    background: #d2a050;
    border-color: #ddb060;
}

QWidget#controlsContent QToolButton[primary="true"]:hover {
    background: #ddb060;
}

QWidget#controlsContent QToolButton[primary="true"]:disabled {
    color: #6a5530;
    background: #3a3530;
    border-color: #4a4540;
}

QWidget#controlsContent QToolButton[danger="true"] {
    color: #e8d0cc;
    background: #4a3535;
    border-color: #6a4545;
}

QWidget#controlsContent QToolButton[danger="true"]:hover {
    background: #5a4040;
}

QWidget#controlsContent QToolButton[danger="true"]:disabled {
    color: #6a5555;
    background: #3a3030;
    border-color: #4a3a3a;
}

QDockWidget#debugDock {
    color: #d0d0d0;
    background: #2b2b2b;
    border-top: 1px solid #444444;
}

QDockWidget#debugDock::title {
    background: #333333;
    padding: 5px 8px;
    text-align: left;
}

QPlainTextEdit#commandLog {
    color: #d0d0d0;
    background: #242424;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 10px;
    selection-background-color: #5a82b4;
}

QScrollBar:vertical {
    width: 12px;
    background: #2b2b2b;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    background: #4a4a4a;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QStatusBar {
    color: #999999;
    background: #2f2f2f;
    border-top: 1px solid #444444;
}

QProgressBar {
    min-height: 6px;
    max-height: 6px;
    border: 0;
    background: #3c3c3c;
    border-radius: 3px;
}

QProgressBar::chunk {
    background: #d2a050;
    border-radius: 3px;
}

QProgressDialog {
    background: #333333;
}

QMessageBox {
    background: #333333;
}
